# Endereço público do site. Em desenvolvimento, pode ser http://localhost:4321.
# Não incluir barra final, caminho, credenciais ou parâmetros.
SITE_URL=https://mariadoreino.com.br

# O pacote do editor tem alertas upstream: manter painel FORA do build público.
# Revisar docs/auditoria-dependencias.md antes de habilitar em produção.
PUBLIC_CMS_ENABLED=false

# Manter false no ambiente de teste. Ativar indexação somente no lançamento aprovado.
PUBLIC_INDEXABLE=false
# Exibir formulário somente após configurar e validar recebimento/privacidade.
PUBLIC_CONTACT_FORM_ENABLED=false

# Origem EXATA em que /admin será usado. Ajustar ao domínio Vercel antes de conectar.
# Uma origem de cada vez; previews aleatórios não recebem autorização automaticamente.
CMS_ORIGIN=https://mariadoreino.com.br

# GitHub OAuth App da associação — valores somente no gerenciador seguro da Vercel.
# Callback: https://SEU-DOMINIO/api/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# public_repo para repositório público; repo somente se necessário para privado.
GITHUB_OAUTH_SCOPE=public_repo

# Integração OPCIONAL de contato. Sem URL válida o endpoint retorna 503, nunca sucesso.
# O receptor deve pertencer à associação ou a um operador aprovado, usar HTTPS,
# aceitar POST JSON e retornar 2xx apenas quando persistir/aceitar a mensagem.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
