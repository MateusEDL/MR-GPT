---
import { site } from '../lib/content';

interface Props {
  kind: 'institutional' | 'cultural';
  variant?: 'header' | 'footer' | 'feature';
  class?: string;
  src?: string;
  decorative?: boolean;
}

const { kind, variant = 'header', class: className, src: override, decorative = false } = Astro.props;
const src = (override || (kind === 'institutional' ? site.logoInstitutional : site.logoCultural))?.trim();
const alt = decorative ? '' : kind === 'institutional' ? 'Maria do Reino' : 'MR Cultural';
---

{src && (
  <span class:list={['brand-logo', `brand-logo--${kind}`, `brand-logo--${variant}`, className]}>
    <img src={src} alt={alt} width="128" height="128" loading={variant === 'header' ? 'eager' : 'lazy'} decoding="async" />
  </span>
)}

<style>
  .brand-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    vertical-align: middle;
    box-sizing: border-box;
    padding: 6px;
    background: #fffdf4;
    border-radius: 48% 52% 46% 54% / 52% 44% 56% 48%;
    overflow: visible;
  }

  .brand-logo img {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    max-width: 100%;
    max-height: none;
    object-fit: contain;
    object-position: center;
    border: 0;
    border-radius: 0;
    margin: 0;
  }

  .brand-logo--header { width: 110px; height: 102px; }
  .brand-logo--feature { width: 160px; height: 150px; margin-bottom: 24px; }
  .brand-logo--footer { width: 90px; height: 84px; }

  @media (max-width: 700px) {
    .brand-logo--header { width: 64px; height: 60px; }
    .brand-logo--feature { width: 128px; height: 120px; margin-bottom: 22px; }
  }
</style>
