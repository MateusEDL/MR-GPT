---
import Icon from './Icon.astro';
import { programs, site, type Program } from '../lib/content';
interface Props { items?: Program[]; compact?: boolean }
const { items = programs, compact = false } = Astro.props;
const publishedItems = items.filter((item) => item.published);
const categories: Record<Program['category'], string> = { saude: 'Saúde e cuidado', cultura: 'Arte e cultura', comunidade: 'Vida em comunidade' };
const statuses: Record<Program['status'], string> = { ativo: 'Programa em atividade', arquivo: 'Acervo', planejamento: 'Em preparação' };
---
<div class:list={['program-list', { 'program-list--compact': compact }]} data-program-list>
  {publishedItems.length > 0 ? publishedItems.map((program) => <article class="program-card" data-program-card data-program-category={program.category}>
    {program.image ? <a class="program-card__image" href={`/tv/programas/${program.slug}/`} tabindex="-1" aria-hidden="true"><img src={program.image} alt="" width="720" height="450" loading="lazy" /></a> : <div class="program-card__seed" aria-hidden="true"><span></span><span></span><span></span></div>}
    <div class="program-card__copy"><p class="program-card__category">{categories[program.category]} <span aria-hidden="true">·</span> {statuses[program.status]}</p><h3><a href={`/tv/programas/${program.slug}/`}>{program.title}</a></h3><p>{program.description}</p><a class="text-link" href={`/tv/programas/${program.slug}/`}>Conhecer o programa <Icon name="up" size={18} /><span class="sr-only"> {program.title}</span></a></div>
  </article>) : <div class="empty-state program-list__empty" data-program-empty><p class="eyebrow">Conversas que aproximam</p><h2>Novas vozes encontram lugar por aqui.</h2><p>Acompanhe os canais oficiais da Maria do Reino para conhecer os conteúdos e as próximas conversas.</p><a class="text-link" href={site.instagram} target="_blank" rel="noopener noreferrer">Acompanhar a Maria do Reino <Icon name="up" size={18} /></a></div>}
</div>
