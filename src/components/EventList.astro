---
import { events, eventIsPast, formatDate, site } from '../lib/content';
import type { Event as EventRecord } from '../lib/content';
import '../styles/pages.css';
interface Props { items?: EventRecord[]; compact?: boolean; cultural?: boolean; }
const { items = events, compact = false, cultural = false } = Astro.props;
const selected = [...items].filter((item) => !cultural || item.cultural);
const future = selected.filter((item) => !eventIsPast(item)).sort((a,b) => a.start.localeCompare(b.start));
const past = selected.filter((item) => eventIsPast(item)).sort((a,b) => b.start.localeCompare(a.start));
const groups = [{ title: 'Próximos encontros', records: compact ? future.slice(0,3) : future, past: false }, { title: 'Eventos com data passada', records: compact ? [] : past, past: true }];
const statusLabels: Record<string,string> = { cancelled: 'Cancelado', postponed: 'Adiado', scheduled: 'Programado' };
---
{selected.length === 0 || (compact && future.length === 0) ? (
  <div class="empty-state">
    <span class="eyebrow">Encontros que aproximam</span>
    <h2>A próxima oportunidade de estar junto.</h2>
    <p>A programação será publicada aqui assim que estiver confirmada, com datas, local e condições de participação. Enquanto isso, acompanhe os canais da associação.</p>
    <a class="text-link" href={cultural ? site.instagramCultural : site.instagram} target="_blank" rel="noopener noreferrer">{cultural ? 'Acompanhar o MR Cultural' : 'Acompanhar a Maria do Reino'} <span aria-hidden="true">↗</span></a>
  </div>
) : groups.map((group) => group.records.length > 0 && (
  <section class="event-group" aria-label={group.title}>
    {!compact && <h2 class="event-group-heading">{group.title}</h2>}
    <div class="entry-grid">{group.records.map((item) => (
      <article class="entry-card" data-event-card data-cultural={String(item.cultural)}>
        {item.image && <img src={item.image} alt={item.imageAlt || ''} width="600" height="450" loading="lazy" />}
        <div class="entry-meta"><time datetime={item.start}>{formatDate(item.start)}</time><span class="pill">{item.status !== 'scheduled' ? statusLabels[item.status] || item.status : group.past ? 'Data passada' : 'Programado'}</span></div>
        <h3><a href={`/agenda/${item.slug}/`}>{item.title}</a></h3>
        <p>{item.description}</p>
        <div class="entry-meta"><span>{item.location}</span><span>{item.cost}</span></div>
        <a class="text-link" href={`/agenda/${item.slug}/`}>Ver informações <span aria-hidden="true">↗</span></a>
      </article>
    ))}</div>
  </section>
))}
