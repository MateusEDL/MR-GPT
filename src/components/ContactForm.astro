---
import { whatsappUrl } from '../lib/content';
import '../styles/pages.css';
interface Props { subject?: 'geral' | 'cultura' | 'associacao' | 'apoio'; }
const { subject = 'geral' } = Astro.props;
const enabled = import.meta.env.PUBLIC_CONTACT_FORM_ENABLED === 'true';
---
{enabled ? (
  <form class="contact-form" data-contact-form>
    <p class="form-hint">Este canal recebe pedidos de contato e propostas. Não envie diagnósticos, laudos, receitas ou outras informações de saúde.</p>
    <div class="form-grid">
      <div class="form-field"><label for="contact-name">Seu nome <span aria-hidden="true">*</span></label><input id="contact-name" name="name" autocomplete="name" required maxlength="100" /></div>
      <div class="form-field"><label for="contact-email">E-mail para retorno <span aria-hidden="true">*</span></label><input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" /></div>
    </div>
    <div class="form-grid">
      <div class="form-field"><label for="contact-city">Cidade e estado</label><input id="contact-city" name="city" autocomplete="address-level2" maxlength="100" /></div>
      <div class="form-field"><label for="contact-subject">Sobre o que quer conversar?</label><select id="contact-subject" name="subject"><option value="geral" selected={subject === 'geral'}>Contato geral</option><option value="associacao" selected={subject === 'associacao'}>Associação e acolhimento</option><option value="cultura" selected={subject === 'cultura'}>Participação cultural</option><option value="apoio" selected={subject === 'apoio'}>Apoio e voluntariado</option></select></div>
    </div>
    <div class="form-field"><label for="contact-message">Sua mensagem <span aria-hidden="true">*</span></label><textarea id="contact-message" name="message" required minlength="10" maxlength="2000" aria-describedby="message-hint"></textarea><p id="message-hint" class="form-hint">Conte brevemente como a equipe pode entrar em contato ou qual é sua proposta. Este formulário não é um atendimento clínico.</p></div>
    <div class="form-honeypot" aria-hidden="true"><label for="contact-website">Deixe este campo em branco</label><input id="contact-website" name="website" tabindex="-1" autocomplete="off" /></div>
    <label class="form-checkbox"><input type="checkbox" name="consent" required /><span>Li a <a href="/politica-de-privacidade/">Política de Privacidade</a> e concordo com o uso destes dados para responder à minha solicitação.</span></label>
    <button class="button button--dark" type="submit">Enviar mensagem <span aria-hidden="true">↗</span></button>
    <p class="form-status" role="status" aria-live="polite" data-contact-status></p>
    <noscript><p>O envio pelo formulário precisa de JavaScript. Você também pode <a href={whatsappUrl}>conversar pelo WhatsApp</a>.</p></noscript>
  </form>
) : (
  <div class="contact-card">
    <strong>Uma conversa é um bom começo.</strong>
    <p>Fale com a equipe pelo WhatsApp para pedir orientação, conhecer os próximos passos ou apresentar uma proposta cultural.</p>
    <a class="button button--dark" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Conversar com a equipe <span aria-hidden="true">↗</span></a>
    <p class="form-hint">Evite enviar documentos ou informações de saúde no primeiro contato. A equipe orientará o canal adequado, quando necessário.</p>
  </div>
)}
<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const requestedSubject = new URLSearchParams(window.location.search).get('assunto');
    const select = form.querySelector<HTMLSelectElement>('select[name="subject"]');
    if (select && requestedSubject && ['geral', 'cultura', 'associacao', 'apoio'].includes(requestedSubject)) select.value = requestedSubject;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const status = form.querySelector<HTMLElement>('[data-contact-status]');
      if (!button || !status) return;
      const data = new FormData(form);
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      status.textContent = 'Enviando sua mensagem…';
      status.removeAttribute('data-state');
      try {
        const response = await fetch('/api/contact', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: data.get('name'), email: data.get('email'), city: data.get('city'), subject: data.get('subject'), message: data.get('message'), website: data.get('website'), consent: data.get('consent') === 'on' }),
          signal: AbortSignal.timeout(20000),
        });
        if (!response.ok) throw new Error('Não foi possível receber sua mensagem neste momento. Tente novamente ou converse com a equipe pelo WhatsApp.');
        status.textContent = 'Sua mensagem foi recebida pelo canal da equipe. O envio não conclui a associação nem agenda uma consulta.';
        status.dataset.state = 'success';
        form.reset();
      } catch (error) {
        status.textContent = error instanceof Error && !['TimeoutError', 'AbortError'].includes(error.name) ? error.message : 'O envio demorou mais que o esperado. Tente novamente ou fale com a equipe pelo WhatsApp.';
        status.dataset.state = 'error';
      } finally {
        button.disabled = false;
        button.removeAttribute('aria-busy');
      }
    });
  });
</script>
