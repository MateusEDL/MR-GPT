---
import Layout from '../../../layouts/Layout.astro';
import { site, galleries } from '../../../lib/content';
import '../../../styles/pages.css';
const approved = galleries.filter((gallery) => gallery.approved);
---
<Layout title="Galeria do MR Cultural | Maria do Reino" description="Um espaço para registros reais, histórias e memórias das atividades do MR Cultural, com contexto e respeito às pessoas." path="/mr-cultural/galeria/">
  <header class="inner-hero cultural-hero"><div class="container"><nav class="page-breadcrumb" aria-label="Você está aqui"><a href="/">Início</a><span aria-hidden="true">/</span><a href="/mr-cultural/">MR Cultural</a><span aria-hidden="true">/</span><span aria-current="page">Galeria</span></nav><p class="eyebrow">Memória viva da comunidade</p><h1>Encontros que ficam com a gente.</h1><p class="lead">Fotografias e vídeos ajudam a contar histórias de convivência. Este espaço reúne os registros cuja publicação foi contextualizada e autorizada.</p></div></header>
  <section class="container list-section" aria-label="Registros culturais">
    {approved.length === 0 ? <div class="empty-state"><p class="eyebrow">Acervo em preparação</p><h2>Cada registro merece contexto e cuidado.</h2><p>A galeria será publicada depois da seleção dos arquivos reais, das legendas, dos créditos e das autorizações necessárias. Nenhuma imagem ilustrativa representa aqui um evento realizado.</p><a class="text-link" href={site.instagramCultural} target="_blank" rel="noopener noreferrer">Acompanhar o perfil do MR Cultural <span aria-hidden="true">↗</span></a></div> : approved.map((gallery) => <section class="gallery-collection"><div class="gallery-heading"><p class="eyebrow">{gallery.activity || 'Registros da comunidade'}{gallery.date && <> · <time datetime={gallery.date}>{new Intl.DateTimeFormat('pt-BR', { dateStyle: 'long', timeZone: 'America/Sao_Paulo' }).format(new Date(`${gallery.date.slice(0,10)}T12:00:00-03:00`))}</time></>}</p><h2>{gallery.title}</h2><p>{gallery.description}</p></div><div class="gallery-grid">{gallery.items.map((item) => <figure><img src={item.src} alt={item.alt} width="900" height="675" loading="lazy" /><figcaption>{item.caption}{item.credit && <span class="gallery-credit">Crédito: {item.credit}</span>}</figcaption></figure>)}</div>{gallery.videoUrl && <div class="gallery-video"><a class="text-link" href={gallery.videoUrl} target="_blank" rel="noopener noreferrer">{gallery.videoTitle || 'Assistir ao registro em vídeo'} <span aria-hidden="true">↗</span></a><p class="form-hint">O vídeo abre no canal externo e não é carregado automaticamente nesta página.</p>{gallery.transcript && <details><summary>Ler transcrição</summary>{gallery.transcript.split(/\n\s*\n/).map((part) => <p>{part}</p>)}</details>}</div>}</section>)}
  </section>
</Layout>
