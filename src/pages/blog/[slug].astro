---
import Layout from '../../layouts/Layout.astro';
import { posts, site, authors } from '../../lib/content';
import '../../styles/pages.css';
export function getStaticPaths() { return posts.map((post) => ({ params: { slug: post.slug }, props: { post } })); }
const { post } = Astro.props;
const authorProfile = authors.find((author) => author.name === post.author);
const hasReview = Boolean(post.reviewer?.trim() && post.reviewedAt?.trim() && Number.isFinite(Date.parse(post.reviewedAt)));
const reviewerProfile = hasReview ? authors.find((author) => author.name === post.reviewer) : undefined;
const personSchema = (name: string, profile: typeof authorProfile) => ({ '@type': 'Person', name, ...(profile?.url ? { url: profile.url } : {}), ...(profile?.bio || profile?.qualification ? { description: [profile.bio, profile.qualification].filter(Boolean).join(' ') } : {}) });
const schema = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.title, description: post.description, datePublished: post.publishedAt, author: personSchema(post.author, authorProfile), publisher: { '@type': 'Organization', name: site.name }, mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(`/blog/${post.slug}/`, site.seo.url).href, ...(hasReview ? { reviewedBy: personSchema(post.reviewer!, reviewerProfile), lastReviewed: post.reviewedAt } : {}) }, ...(post.image ? { image: new URL(post.image, site.seo.url).href } : {}) };
const profiles = [{ label: 'Autoria', profile: authorProfile }, { label: 'Revisão', profile: reviewerProfile }].filter((entry) => entry.profile);
---
<Layout title={`${post.title} | Maria do Reino`} description={post.description} path={`/blog/${post.slug}/`} image={post.image} schema={schema}>
  <header class="inner-hero"><div class="container"><nav class="page-breadcrumb" aria-label="Você está aqui"><a href="/">Início</a><span aria-hidden="true">/</span><a href="/blog/">Conteúdos</a><span aria-hidden="true">/</span><span aria-current="page">{post.title}</span></nav><p class="eyebrow">{post.category}</p><h1>{post.title}</h1><p class="lead">{post.description}</p><div class="article-meta"><span>Por {post.author}</span><span>Publicado em <time datetime={post.publishedAt}>{new Intl.DateTimeFormat('pt-BR', { dateStyle: 'long', timeZone: 'America/Sao_Paulo' }).format(new Date(`${post.publishedAt.slice(0,10)}T12:00:00-03:00`))}</time></span>{hasReview && <span>Revisão: {post.reviewer} · <time datetime={post.reviewedAt}>{post.reviewedAt}</time></span>}</div></div></header>
  <div class="container content-layout"><article class="page-prose">{post.image && <img class="article-image" src={post.image} alt={post.imageAlt || ''} width="1200" height="675" />} {post.body.split(/\n\s*\n/).filter(Boolean).map((body) => <p>{body}</p>)}<aside class="health-note">Conteúdo informativo. Informações sobre saúde não substituem avaliação e acompanhamento por profissional habilitado.</aside>{profiles.length > 0 && <section class="editorial-profiles" aria-label="Autoria e revisão">{profiles.map(({ label, profile }) => profile && <div class="editorial-profile">{profile.image && <img src={profile.image} alt={profile.imageAlt || profile.name} width="72" height="72" loading="lazy" />}<div><p class="eyebrow">{label}</p><h2>{profile.name}</h2>{profile.qualification && <p class="profile-qualification">{profile.qualification}</p>}{profile.bio.split(/\n\s*\n/).filter(Boolean).map((paragraph) => <p>{paragraph}</p>)}{profile.url && <a href={profile.url} target="_blank" rel="noopener noreferrer">Conhecer o perfil profissional <span aria-hidden="true">↗</span></a>}</div></div>)}</section>}<div class="page-actions"><a class="text-link" href="/blog/">← Voltar aos conteúdos</a></div></article><aside class="page-aside"><p class="eyebrow">Continuar a conversa</p><h2>Conheça os caminhos do acolhimento.</h2><p>Entenda como a associação orienta pacientes e familiares e onde começa a atuação dos profissionais de saúde.</p><a class="text-link" href="/acolhimento/">Conhecer o acolhimento <span aria-hidden="true">↗</span></a></aside></div>
</Layout>
