---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import { professionals, site, whatsappUrl } from '../../lib/content';
import type { Professional } from '../../lib/content';
import '../../styles/pages.css';
import '../../styles/professionals.css';

export function getStaticPaths() {
  return professionals.filter((person) => person.published).map((person) => ({ params: { slug: person.slug }, props: { person } }));
}
interface Props { person: Professional; }
const { person } = Astro.props;
const cultural = person.areas.includes('cultura');
const health = person.areas.includes('saude');
const initials = person.name.trim().split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part.charAt(0)).join('');
const labels = { saude: 'Saúde', cultura: 'MR Cultural' };
const bio = person.bio?.split(/\n\s*\n/).filter(Boolean) || [];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: person.role,
  description: person.summary,
  url: new URL(`/profissionais/${person.slug}/`, site.seo.url).href,
  ...(person.image ? { image: new URL(person.image, site.seo.url).href } : {}),
  ...(person.profileUrl ? { sameAs: [person.profileUrl] } : {}),
};
---
<Layout title={`${person.name} | Profissionais Maria do Reino`} description={person.summary} path={`/profissionais/${person.slug}/`} image={person.image} schema={schema}>
  <header class:list={['inner-hero', 'professional-profile-hero', { 'cultural-hero': cultural && !health }]} data-scene={cultural && !health ? 'culture' : 'forest'}>
    <div class="hero-organic-art" aria-hidden="true"></div>
    <div class="container">
      <nav class="page-breadcrumb" aria-label="Você está aqui"><a href="/">Início</a><span aria-hidden="true">/</span><a href="/profissionais/">Profissionais</a><span aria-hidden="true">/</span><span aria-current="page">{person.name}</span></nav>
      <div class="professional-profile-heading">
        <div class="professional-profile-portrait">{person.image ? <img src={person.image} alt={person.imageAlt || `Retrato de ${person.name}`} width="640" height="720" fetchpriority="high" /> : <span class="professional-initials" aria-hidden="true">{initials}</span>}</div>
        <div><div class="professional-areas">{person.areas.map((area) => <span class:list={['professional-area', { 'professional-area--cultural': area === 'cultura' }]}>{labels[area]}</span>)}</div><h1>{person.name}</h1><p class="professional-profile-role">{person.role}</p>{person.credentialVerified && person.credentials && <p class="professional-profile-credentials">{person.credentials}</p>}<p class="lead">{person.summary}</p></div>
      </div>
    </div>
  </header>
  <div class="container content-layout professional-profile-content">
    <article class="page-prose">
      {bio.length > 0 && <section><p class="eyebrow">Conheça a trajetória</p><h2>Saberes e atuação</h2>{bio.map((paragraph) => <p>{paragraph}</p>)}</section>}
      <section class="professional-contact" aria-labelledby="professional-contact-title"><h2 id="professional-contact-title">Continuar essa conversa</h2><p>Para conhecer as formas de participação{health ? ' ou de atendimento' : ''}, confirme os próximos passos e as condições diretamente pelo canal de contato.</p><div class="professional-actions"><a class="button button--dark" href={person.contactUrl || whatsappUrl} target="_blank" rel="noopener noreferrer">{person.contactUrl ? 'Entrar em contato' : 'Falar com a equipe'} <Icon name="up" size={18} /></a>{person.profileUrl && <a class="text-link" href={person.profileUrl} target="_blank" rel="noopener noreferrer">Ver perfil profissional <Icon name="up" size={18} /></a>}</div></section>
      {health && <aside class="health-note">O acolhimento da associação orienta e encaminha. Avaliação, prescrição e acompanhamento de saúde cabem a profissionais habilitados. Confirme a disponibilidade e as condições do atendimento antes de agendar.</aside>}
      <div class="professional-return"><a class="text-link" href="/profissionais/"><span aria-hidden="true" style="display:inline-flex;transform:rotate(180deg)"><Icon name="arrow" size={18} /></span> Todos os profissionais</a>{cultural && <a class="text-link" href="/mr-cultural/profissionais/">Profissionais do MR Cultural <Icon name="up" size={18} /></a>}</div>
    </article>
    <aside class="page-aside"><p class="eyebrow">{cultural ? 'A cultura aproxima' : 'O cuidado começa na escuta'}</p><h2>{cultural ? 'Um espaço para compartilhar saberes.' : 'Conheça os caminhos do acolhimento.'}</h2><p>{cultural ? 'Uma ideia, uma oficina, uma troca: converse com a equipe sobre como participar da construção do MR Cultural.' : 'A equipe pode ouvir sua dúvida e orientar sobre associação e acolhimento.'}</p><a class="text-link" href={cultural ? '/mr-cultural/#participar' : '/acolhimento/'}>{cultural ? 'Participar do MR Cultural' : 'Conhecer o acolhimento'} <Icon name="up" size={18} /></a></aside>
  </div>
</Layout>
