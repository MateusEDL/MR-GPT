---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CurveEdge from '../components/CurveEdge.astro';
import BrandLogo from '../components/BrandLogo.astro';
import ProfessionalList from '../components/ProfessionalList.astro';
import ProgramList from '../components/ProgramList.astro';
import {home,site,pages,posts,events,partners,eventIsPast,formatDate} from '../lib/content';
import '../styles/home.css';
import '../styles/tv.css';
import '../styles/home-people-media.css';
const titleWords=home.title.trim().split(' ');
const titleLast=titleWords.pop();
const titleFirst=titleWords.join(' ');
const paths=[{slug:'acolhimento',icon:'hands',label:'01'},{slug:'cannabis-medicinal',icon:'leaf',label:'02'},{slug:'mr-cultural',icon:'sun',label:'03'}];
const cards=paths.map(path=>({...path,...pages.find(page=>page.slug===path.slug)!}));
const questions=pages.find(page=>page.slug==='perguntas-frequentes')?.faqs?.slice(0,4)||[];
const upcoming=events.filter(event=>!eventIsPast(event)&&event.status==='scheduled').slice(0,3);
const careImage=home.careImage;
const manifestoImage=home.manifestoImage;
const careSet=careImage==='/images/botanica-orvalho-ia.webp'?'/images/botanica-orvalho-ia-640.webp 640w, /images/botanica-orvalho-ia-960.webp 960w, /images/botanica-orvalho-ia.webp 1536w':undefined;
const manifestoSet=manifestoImage==='/images/jardim-medicinal-ia.webp'?'/images/jardim-medicinal-ia-768.webp 768w, /images/jardim-medicinal-ia-1280.webp 1280w, /images/jardim-medicinal-ia.webp 1774w':undefined;
---
<Layout title="Maria do Reino — acolhimento, informação e cultura" description={site.description} path="/" immersive>
  <div class="organic-home">
    <section class="hero" aria-labelledby="hero-title" data-scene="forest">
      <figure class="hero-landscape scene-media" data-parallax="0.08"><img src="/images/hero-botanico-ia-1280.webp" srcset="/images/hero-botanico-ia-768.webp 768w, /images/hero-botanico-ia-1280.webp 1280w, /images/hero-botanico-ia.webp 1774w" sizes="(max-width:700px) 1800px,100vw" width="1774" height="887" alt="Folhagens verdes e plantas de cannabis em um jardim botânico ilustrativo, iluminadas pelo sol." fetchpriority="high"/><figcaption>Imagem ilustrativa gerada por IA</figcaption></figure>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="container hero-copy">
        <span class="eyebrow">{home.eyebrow}</span>
        <h1 id="hero-title">{titleFirst}<br/><em>{titleLast}</em></h1>
        <p>{home.intro}</p>
        <div class="hero-actions"><a class="button button--botanical" href="/como-se-associar/">{home.primaryLabel}<Icon name="up" size={19}/></a><a class="hero-secondary" href="/mr-cultural/">{home.secondaryLabel}<Icon name="arrow" size={20}/></a></div>
        <div class="hero-reassurance"><Icon name="check" size={16}/><span>{home.reassurance}</span></div>
      </div>
      <div class="hero-bottom container"><a class="scroll-invitation" href="#raizes"><span><Icon name="arrow" size={18}/></span>Deixe o cuidado florescer</a><span class="hero-place">{site.city}, Santa Catarina<br/>Filantropia · Natureza · Cultura</span></div>
      <div class="rotating-note" aria-hidden="true"><svg viewBox="0 0 180 180"><defs><path id="care-circle" d="M90 90m-66 0a66 66 0 1 1 132 0a66 66 0 1 1-132 0"/></defs><text><textPath href="#care-circle" textLength="410">ACOLHER · CULTIVAR · CONVIVER · </textPath></text></svg><Icon name="leaf" size={38}/></div>
      <CurveEdge fill="#fbf6e9"/>
    </section>

    <section class="care-section" id="raizes" aria-labelledby="care-title" data-scene="earth">
      <div class="container">
        <div class="care-heading" data-reveal><span class="eyebrow">{home.careEyebrow}</span><h2 id="care-title">{home.careTitle}</h2><p>{home.careIntro}</p></div>
        <div class="care-flow">
          <div class="care-paths">{cards.map(card=><a class="care-path" href={`/${card.slug}/`} data-reveal><span class="path-count">{card.label}</span><div><span class="path-label"><Icon name={card.icon} size={20}/>{card.eyebrow}</span><h3>{card.title}</h3><p>{card.description}</p></div><span class="path-arrow"><Icon name="up" size={24}/></span></a>)}<p class="care-footnote">{home.careFootnote}</p></div>
          <div class="care-garden" data-reveal><span class="botanical-outline" aria-hidden="true"></span><figure class="garden-portrait scene-media" data-parallax="0.06"><img src={careImage} srcset={careSet} sizes="(max-width:760px) 100vw,55vw" width="1536" height="1024" alt={home.careImageAlt} loading="lazy"/>{careImage.startsWith('/images/')&&careImage.includes('-ia')&&<figcaption>Imagem ilustrativa gerada por IA</figcaption>}</figure><p class="garden-note">{home.imageLabelTitle}<small>{home.imageLabelSubtitle}</small></p></div>
        </div>
      </div>
    </section>

    <section class="home-professionals-section" id="profissionais" aria-labelledby="home-professionals-title" data-scene="forest" data-home-professionals>
      <div class="container">
        <div class="home-collection-heading" data-reveal>
          <div><span class="eyebrow">{home.professionalsEyebrow}</span><h2 id="home-professionals-title">{home.professionalsTitle}<br/><em>{home.professionalsTitleEmphasis}</em></h2></div>
          <p>{home.professionalsIntro}</p>
        </div>
        <ProfessionalList compact headingLevel="h3" />
        <div class="home-collection-footer"><a class="text-link" href="/profissionais/">Conhecer todos os profissionais<Icon name="up" size={20}/></a></div>
      </div>
    </section>

    <section class="culture-section" aria-labelledby="culture-title" data-scene="culture">
      <CurveEdge fill="#fbf6e9" top variant="rolling"/>
      <div class="culture-glow" aria-hidden="true"></div>
      <div class="word-river" aria-hidden="true"><div>CRIAR &nbsp;·&nbsp; SENTIR &nbsp;·&nbsp; PERTENCER &nbsp;·&nbsp; CRIAR &nbsp;·&nbsp; SENTIR &nbsp;·&nbsp; PERTENCER &nbsp;·&nbsp;</div></div>
      <div class="container culture-grid">
        <div class="culture-copy" data-reveal><span class="eyebrow">MR Cultural</span><p class="culture-byline">{home.cultureEyebrow}</p><BrandLogo kind="cultural" variant="feature"/><h2 id="culture-title">{home.cultureTitle}<em>.</em></h2><p class="culture-kicker">{home.cultureKicker}</p><p>{home.cultureIntro}</p><div class="culture-tags"><span>Arte</span><span>Convivência</span><span>Expressão</span><span>Comunidade</span></div><a class="button button--orange" href="/mr-cultural/">{home.cultureButton}<Icon name="up" size={20}/></a></div>
        <div class="culture-visual" data-reveal><div class="culture-orbit" aria-hidden="true"></div><figure class="scene-media culture-photo" data-parallax="0.07"><img src="/images/cultura-oficina-ia-960.webp" srcset="/images/cultura-oficina-ia-640.webp 640w, /images/cultura-oficina-ia-960.webp 960w, /images/cultura-oficina-ia.webp 1448w" sizes="(max-width:760px) 100vw,52vw" width="1448" height="1086" alt="Mãos adultas criando com tintas e cerâmica em uma oficina artística ilustrativa." loading="lazy"/><figcaption>Imagem ilustrativa gerada por IA</figcaption></figure><span class="culture-sideword" aria-hidden="true">vida em movimento</span></div>
      </div>
      <CurveEdge fill="#e1e9d6" variant="rolling"/>
    </section>

    <section class="nature-section" aria-labelledby="nature-title" data-scene="earth"><div class="container nature-grid">
      <div class="nature-visual" data-reveal><figure class="scene-media nature-photo" data-parallax="0.06"><img src="/images/cultivo-vivo-ia-960.webp" srcset="/images/cultivo-vivo-ia-640.webp 640w, /images/cultivo-vivo-ia-960.webp 960w, /images/cultivo-vivo-ia-1440.webp 1440w" sizes="(max-width:760px) 100vw,55vw" width="1536" height="1024" alt="Mãos adultas cuidando da terra e de pequenas mudas em um cultivo ilustrativo." loading="lazy"/><figcaption>Imagem ilustrativa gerada por IA</figcaption></figure><svg class="growing-line" viewBox="0 0 260 360" fill="none" aria-hidden="true"><path d="M120 350C40 300 220 240 110 170C40 120 110 60 140 10M110 170C180 160 220 110 220 110C160 85 115 125 110 170ZM105 255C40 245 20 190 20 190C85 175 116 220 105 255Z" stroke="currentColor" stroke-width="1"/></svg></div>
      <div class="nature-copy" data-reveal><span class="eyebrow">{home.natureEyebrow}</span><h2 id="nature-title">{home.natureTitle}</h2><p>{home.natureIntro}</p><a class="text-link" href="/quem-somos/">Conheça o que nos move<Icon name="up" size={22}/></a><span class="nature-signature" aria-hidden="true">da terra, para a vida.</span></div>
    </div><CurveEdge fill="#fbf6e9"/></section>

    <section class="home-media-section" id="na-midia" aria-labelledby="home-media-title" data-scene="culture" data-home-media>
      <CurveEdge fill="#fbf6e9" top variant="rolling"/>
      <div class="container">
        <div class="home-collection-heading" data-reveal>
          <div><span class="eyebrow">{home.mediaEyebrow}</span><h2 id="home-media-title">{home.mediaTitle}<br/><em>{home.mediaTitleEmphasis}</em></h2></div>
          <p>{home.mediaIntro}</p>
        </div>
        <ProgramList compact />
        <div class="home-collection-footer"><a class="text-link" href="/tv/">Explorar a TV e os programas<Icon name="up" size={20}/></a></div>
      </div>
      <CurveEdge fill="#fbf6e9"/>
    </section>

    <section class="community-section" data-scene="earth"><div class="container"><div class="section-heading" data-reveal><div><span class="eyebrow">{home.agendaEyebrow}</span><h2>{home.agendaTitle}</h2></div><a class="text-link" href="/mr-cultural/agenda/">Conheça a agenda cultural<Icon name="up" size={22}/></a></div>
      {upcoming.length?<div class="home-events">{upcoming.map(event=><a class="home-event" href={`/agenda/${event.slug}/`} data-reveal><span class="eyebrow">{formatDate(event.start)}</span><h3>{event.title}</h3><p>{event.description}</p><span class="text-link">Informações e participação<Icon name="arrow" size={18}/></span></a>)}</div>:<div class="community-invitation" data-reveal><span class="invitation-sun"><Icon name="sun" size={58}/></span><div><h3>{home.agendaEmptyTitle}</h3><p>{home.agendaEmptyDescription}</p><a class="text-link" href={site.instagramCultural} target="_blank" rel="noopener noreferrer">Acompanhe o MR Cultural<Icon name="up" size={20}/></a></div></div>}
      <div class="community-links">{[{title:'Projetos e ações',href:'/mr-cultural/projetos/',word:'Criar',tone:'green'},{title:'Memórias e registros',href:'/mr-cultural/galeria/',word:'Sentir',tone:'wine'},{title:'Proponha uma atividade',href:'/contato/?assunto=cultura',word:'Pertencer',tone:'orange'}].map(link=><a href={link.href} class={`community-link community-link--${link.tone}`} data-reveal><span class="link-word">{link.word}</span><span>{link.title}<Icon name="up" size={22}/></span></a>)}</div>
    </div></section>

    <section class="manifesto-section manifesto-section--botanical" data-scene="forest"><CurveEdge fill="#fbf6e9" top/><figure class="manifesto-landscape scene-media" data-parallax="0.06"><img src={manifestoImage} srcset={manifestoSet} sizes="(max-width:700px) 1800px,100vw" width="1774" height="887" alt={home.manifestoImageAlt} loading="lazy"/>{manifestoImage.startsWith('/images/')&&manifestoImage.includes('-ia')&&<figcaption>Imagem ilustrativa gerada por IA</figcaption>}</figure><div class="manifesto-photo-shade" aria-hidden="true"></div><div class="manifesto-shape" aria-hidden="true"></div><div class="container manifesto-inner" data-reveal><span class="eyebrow">{home.manifestoEyebrow}</span><blockquote>{home.manifestoQuote}</blockquote><span class="manifesto-attribution">{home.manifestoAttribution}</span><a class="text-link" href="/quem-somos/">Conheça nossa história<Icon name="arrow" size={20}/></a></div><CurveEdge fill="#fbf6e9" variant="rolling"/></section>

    {posts.length>0&&<section class="stories-section"><div class="container"><div class="section-heading"><div><span class="eyebrow">Informação que acolhe</span><h2>Para ler, entender<br/>e compartilhar.</h2></div><a class="text-link" href="/blog/">Todos os conteúdos<Icon name="arrow" size={20}/></a></div><div class="home-events">{posts.slice(0,3).map(post=><a class="home-event" href={`/blog/${post.slug}/`}><span class="eyebrow">{post.category}</span><h3>{post.title}</h3><p>{post.description}</p><span class="text-link">Ler conteúdo<Icon name="arrow" size={18}/></span></a>)}</div></div></section>}

    <section class="faq-section" data-scene="earth"><div class="container faq-grid"><div data-reveal><span class="eyebrow">{home.faqEyebrow}</span><h2>{home.faqTitle}</h2><p>{home.faqIntro}</p><a class="text-link" href="/perguntas-frequentes/">Todas as perguntas<Icon name="arrow" size={20}/></a></div><div class="home-faqs" data-reveal>{questions.map(q=><details><summary>{q.question}<span><Icon name="plus" size={20}/></span></summary><p>{q.answer}</p></details>)}</div></div></section>

    {partners.length>0&&<section class="partners-section"><div class="container"><span class="eyebrow">Quem caminha junto</span><h2>Parcerias que aproximam.</h2><div class="partner-grid">{partners.map(partner=><div>{partner.image&&<img src={partner.image} alt={partner.imageAlt||partner.name} width="160" height="100" loading="lazy"/>}<h3>{partner.name}</h3>{partner.description&&<p>{partner.description}</p>}{partner.url&&<a class="text-link" href={partner.url} target="_blank" rel="noopener noreferrer">Conhecer<Icon name="up" size={17}/></a>}</div>)}</div></div></section>}

    <section class="participation-section" data-scene="culture"><CurveEdge fill="#fbf6e9" top variant="rolling"/><div class="participation-orbit" aria-hidden="true"></div><div class="container participation-inner" data-reveal><span class="eyebrow">{home.supportEyebrow}</span><h2>{home.participationTitle}</h2><p>{home.participationIntro}</p><a class="button button--wine" href="/apoie/">Quero fazer parte<Icon name="up" size={22}/></a></div><CurveEdge fill="#103d30"/></section>
  </div>
</Layout>
<script>
  (()=>{
    const root=document.documentElement;
    const targets=[...document.querySelectorAll<HTMLElement>('[data-parallax]')];
    const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame=0,pointerX=0,pointerY=0;
    const paused=()=>reduced.matches||root.classList.contains('motion-paused');
    function render(){
      frame=0;
      for(const target of targets){
        if(paused()){target.style.removeProperty('--image-x');target.style.removeProperty('--image-y');continue;}
        const rect=target.getBoundingClientRect();
        if(rect.bottom<0||rect.top>window.innerHeight)continue;
        const depth=Number(target.dataset.parallax)||.06;
        const displacement=Math.max(-36,Math.min(36,(window.innerHeight/2-rect.top-rect.height/2)*depth));
        target.style.setProperty('--image-x',`${pointerX*11}px`);
        target.style.setProperty('--image-y',`${displacement+pointerY*8}px`);
      }
    }
    const schedule=()=>{if(!frame&&!document.hidden)frame=requestAnimationFrame(render);};
    window.addEventListener('scroll',schedule,{passive:true});
    window.addEventListener('pointermove',event=>{if(paused())return;pointerX=event.clientX/window.innerWidth-.5;pointerY=event.clientY/window.innerHeight-.5;schedule();},{passive:true});
    window.addEventListener('mr:motion-change',schedule);
    reduced.addEventListener('change',schedule);
    document.addEventListener('visibilitychange',()=>{if(document.hidden&&frame){cancelAnimationFrame(frame);frame=0;}else schedule();});
    if('IntersectionObserver' in window&&!paused()){
      const reveals=[...document.querySelectorAll<HTMLElement>('[data-reveal]')];
      root.classList.add('motion-ready');
      const observer=new IntersectionObserver(entries=>{for(const entry of entries){if(entry.isIntersecting){entry.target.classList.add('is-visible');observer.unobserve(entry.target);}}},{threshold:.07,rootMargin:'0px 0px 25px 0px'});
      reveals.forEach(target=>observer.observe(target));
    }
    schedule();
  })();
</script>
