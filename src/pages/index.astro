---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import {home,site,pages,posts,events,partners,eventIsPast,formatDate} from '../lib/content';
import '../styles/home.css';
const titleWords=home.title.trim().split(' ');
const titleLast=titleWords.pop();
const titleFirst=titleWords.join(' ');
const paths=[{slug:'acolhimento',icon:'hands',label:'01'},{slug:'cannabis-medicinal',icon:'leaf',label:'02'},{slug:'mr-cultural',icon:'sun',label:'03'}];
const cards=paths.map(path=>({...path,...pages.find(page=>page.slug===path.slug)!}));
const questions=pages.find(page=>page.slug==='perguntas-frequentes')?.faqs?.slice(0,4)||[];
const upcoming=events.filter(event=>!eventIsPast(event)&&event.status==='scheduled').slice(0,3);
---
<Layout title="Maria do Reino — acolhimento, informação e cultura" description={site.description} path="/">
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <span class="eyebrow">{home.eyebrow}</span>
      <h1 id="hero-title">{titleFirst}<br/><em>{titleLast}</em></h1>
      <p>{home.intro}</p>
      <div class="hero-actions"><a class="button button--dark" href="/como-se-associar/">{home.primaryLabel}<Icon name="up" size={18}/></a><a class="hero-secondary" href="/mr-cultural/">{home.secondaryLabel}<Icon name="arrow" size={17}/></a></div>
      <div class="hero-reassurance"><span class="small-check"><Icon name="check" size={12}/></span><span>{home.reassurance}</span></div>
    </div>
    <div class="hero-visual">
      <figure class="hero-image"><img src="/images/hero-jardim-ia-960.webp" srcset="/images/hero-jardim-ia-640.webp 640w, /images/hero-jardim-ia-960.webp 960w, /images/hero-jardim-ia.webp 1448w" sizes="(max-width: 760px) 100vw, 48vw" width="1448" height="1086" alt="Jardim ilustrativo com plantas, luz natural e uma mesa de madeira." fetchpriority="high"/><figcaption>Imagem ilustrativa gerada por IA</figcaption></figure>
      <div class="hero-label"><span class="hero-label-icon"><Icon name="heart" size={19}/></span><div>{home.imageLabelTitle}<small>{home.imageLabelSubtitle}</small></div></div>
      <span class="hero-side-note">CUIDADO INTEGRAL · VIDA EM COMUNIDADE</span>
    </div>
  </section>

  <div class="principles-strip"><div class="container principles-inner"><span><Icon name="heart" size={17}/>Sem fins lucrativos</span><span><Icon name="hands" size={19}/>Associação gratuita</span><span><Icon name="pin" size={17}/>{site.city}, Santa Catarina</span><a href="/quem-somos/">Conheça nossa essência<Icon name="arrow" size={16}/></a></div></div>

  <section class="section care-section" aria-labelledby="care-title">
    <div class="container">
      <div class="section-heading"><div><span class="eyebrow">{home.careEyebrow}</span><h2 id="care-title">{home.careTitle}</h2></div><p>{home.careIntro}</p></div>
      <div class="care-grid">{cards.map(card=><a class="care-card" href={`/${card.slug}/`}><div class="care-card-top"><span class="care-icon"><Icon name={card.icon} size={27}/></span><span class="card-number">{card.label}</span></div><h3>{card.title}</h3><p>{card.description}</p><span class="care-card-link">Conhecer esse caminho<Icon name="arrow" size={19}/></span></a>)}</div>
      <p class="care-footnote">{home.careFootnote}</p>
    </div>
  </section>

  <section class="culture-section" aria-labelledby="culture-title"><div class="container culture-grid">
    <div class="culture-visual"><figure><img src="/images/cultura-oficina-ia-960.webp" srcset="/images/cultura-oficina-ia-640.webp 640w, /images/cultura-oficina-ia-960.webp 960w, /images/cultura-oficina-ia.webp 1448w" sizes="(max-width: 760px) 100vw, 45vw" width="1448" height="1086" alt="Mãos adultas pintando em uma mesa de oficina artística ilustrativa." loading="lazy"/><figcaption>Imagem ilustrativa gerada por IA</figcaption></figure><span class="culture-sticker"><Icon name="sun" size={32}/><span>ARTE, ENCONTRO<br/>E PERTENCIMENTO</span></span></div>
    <div class="culture-copy"><span class="eyebrow">MR Cultural</span><p class="culture-byline">{home.cultureEyebrow}</p>{site.logoCultural&&<img class="cultural-original-logo" src={site.logoCultural} alt="MR Cultural" width="100" height="100" loading="lazy"/>}<h2 id="culture-title">{home.cultureTitle}<span class="culture-period">.</span></h2><p>{home.cultureIntro}</p><div class="culture-tags"><span>Arte</span><span>Convivência</span><span>Expressão</span><span>Comunidade</span></div><a class="button button--light" href="/mr-cultural/">{home.cultureButton}<Icon name="up" size={18}/></a></div>
  </div></section>

  <section class="section community-section"><div class="container"><div class="section-heading"><div><span class="eyebrow">{home.agendaEyebrow}</span><h2 style="white-space:pre-line">{home.agendaTitle}</h2></div><a class="text-link" href="/mr-cultural/agenda/">Conheça a agenda cultural<Icon name="arrow" size={18}/></a></div>
    {upcoming.length?<div class="home-events">{upcoming.map(event=><a class="home-event" href={`/agenda/${event.slug}/`}><span class="eyebrow">{formatDate(event.start)}</span><h3>{event.title}</h3><p>{event.description}</p><span class="text-link">Informações e participação<Icon name="arrow" size={17}/></span></a>)}</div>:<div class="community-invitation"><div class="invitation-icon"><Icon name="calendar" size={30}/></div><div><h3>{home.agendaEmptyTitle}</h3><p>{home.agendaEmptyDescription}</p></div><a class="text-link" href={site.instagramCultural} target="_blank" rel="noopener noreferrer">Acompanhe o MR Cultural<Icon name="up" size={17}/></a></div>}
    <div class="community-links"><a href="/mr-cultural/projetos/"><span><Icon name="sun" size={20}/>Projetos e ações</span><Icon name="up" size={19}/></a><a href="/mr-cultural/galeria/"><span><Icon name="book" size={20}/>Memórias e registros</span><Icon name="up" size={19}/></a><a href="/contato/?assunto=cultura"><span><Icon name="music" size={20}/>Proponha uma atividade</span><Icon name="up" size={19}/></a></div>
  </div></section>

  <section class="manifesto-section"><div class="container manifesto-inner"><span class="eyebrow">{home.manifestoEyebrow}</span><blockquote>{home.manifestoQuote}</blockquote><span class="manifesto-attribution">{home.manifestoAttribution}</span><a class="text-link" href="/quem-somos/">Conheça nossa história<Icon name="arrow" size={18}/></a></div></section>

  {posts.length>0&&<section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">Informação que acolhe</span><h2>Para ler, entender<br/>e compartilhar.</h2></div><a class="text-link" href="/blog/">Todos os conteúdos<Icon name="arrow" size={18}/></a></div><div class="home-events">{posts.slice(0,3).map(post=><a class="home-event" href={`/blog/${post.slug}/`}><span class="eyebrow">{post.category}</span><h3>{post.title}</h3><p>{post.description}</p><span class="text-link">Ler conteúdo<Icon name="arrow" size={17}/></span></a>)}</div></div></section>}

  <section class="section faq-section"><div class="container faq-grid"><div><span class="eyebrow">{home.faqEyebrow}</span><h2 style="white-space:pre-line">{home.faqTitle}</h2><p>{home.faqIntro}</p><a class="text-link" href="/perguntas-frequentes/">Todas as perguntas<Icon name="arrow" size={17}/></a></div><div class="home-faqs">{questions.map(q=><details><summary>{q.question}<span><Icon name="plus" size={17}/></span></summary><p>{q.answer}</p></details>)}</div></div></section>

  {partners.length>0&&<section class="section"><div class="container"><span class="eyebrow">Quem caminha junto</span><h2>Parcerias que aproximam.</h2><div class="partner-grid">{partners.map(partner=><div>{partner.image&&<img src={partner.image} alt={partner.imageAlt||partner.name} width="160" height="100" loading="lazy"/>}<h3>{partner.name}</h3>{partner.description&&<p>{partner.description}</p>}{partner.url&&<a class="text-link" href={partner.url} target="_blank" rel="noopener noreferrer">Conhecer<Icon name="up" size={15}/></a>}</div>)}</div></div></section>}

  <section class="participation-section"><div class="container participation-inner"><div><span class="eyebrow">{home.supportEyebrow}</span><h2>{home.participationTitle}</h2><p>{home.participationIntro}</p></div><a class="button button--dark" href="/apoie/">Quero fazer parte<Icon name="up" size={19}/></a></div></section>
</Layout>
